title: "CCMAP: Climate Change Curriculum Map"
version: 1.0.0
date-released: 2026-07-28
license: MIT
repository-code: "https://github.com/yujchang2017/ccmap"
authors:
  - family-names: "Chang"
    given-names: "Yu-Jie"          
