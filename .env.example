# Copy to .env for local development (DO NOT commit .env)
# Heroku: set these in Dashboard -> Settings -> Config Vars

# Required
OPENAI_API_KEY=
MONGO_URI=
SECRET_KEY=

# Runtime
FLASK_ENV=production
DEBUG=false

# CORS
CORS_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# Optional: Upstash Redis (rate limiting / burst protection)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Mongo connection pool tuning
MONGO_MAX_POOL_SIZE=35
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=10000

# Tests only
CCMAP_TEST_URL=http://127.0.0.1:5001
